/* cyclotomic_cosets.h */
#ifndef CYCLOTOMIC_COSETS_H
#define CYCLOTOMIC_COSETS_H

#include <stddef.h>  // size_t

#ifdef __cplusplus
extern \"C\" {
#endif

/** Un coset como array dinámico de elementos. */
typedef struct {
    size_t *data;  ///< elementos del coset
    size_t len;    ///< número de elementos
    size_t cap;    ///< capacidad interna (para realloc)
} Coset;

/** Lista de cosets (array dinámico de Coset). */
typedef struct {
    Coset *data;   ///< array de cosets
    size_t len;    ///< número de cosets
    size_t cap;    ///< capacidad interna
} CosetList;

/**
 * @brief Calcula los cyclotomic cosets (órbitas bajo x -> (k*x) mod N)
 *        para todos los residuos 0..N-1.
 *
 * - Si N == 0: devuelve una lista vacía.
 * - Si gcd(k,N) == 1: cada coset es un ciclo cerrado.
 * - Si gcd(k,N) != 1: pueden aparecer cadenas que desembocan en ciclos; se devuelve
 *   la órbita hacia delante hasta repetir algún elemento.
 *
 * @param k  multiplicador
 * @param N  módulo
 * @return   CosetList con memoria ya reservada. Debes llamar a free_cosetlist().
 */
CosetList cyclotomic_cosets(size_t k, size_t N);

/**
 * @brief Libera toda la memoria asociada a un CosetList (incluye cada Coset y sus arrays).
 *
 * @param cl  puntero a la lista a liberar (admite lista vacía). Tras la llamada,
 *            cl->data == NULL y cl->len == cl->cap == 0.
 */
void free_cosetlist(CosetList *cl);

/**
 * @brief Imprime por stdout el contenido de los cosets (utilidad de depuración).
 *
 * @param cl  lista de cosets.
 */
void cosetlist_print(const CosetList *cl);

#ifdef __cplusplus
}
#endif

#endif /* CYCLOTOMIC_COSETS_H */
