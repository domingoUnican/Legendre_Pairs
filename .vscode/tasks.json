{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc compilar proyecto",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/src/main.c",               /* ← RUTA COMPLETA */
                "${workspaceFolder}/src/cyclotomic_cosets.c",  /* ← RUTA COMPLETA */
                "${workspaceFolder}/src/mymath.c",  /* ← RUTA COMPLETA */
                "-o",
                "${workspaceFolder}\\programa.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compilador: gcc"
        }
    ]
}