// cyclotomic_cosets.c
// Compilar: cc -std=c11 -O2 -Wall -Wextra cyclotomic_cosets.c -o cosets
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <stdint.h>
#include <stddef.h>

// --------- Estructuras de datos ---------
typedef struct {
    size_t *data;
    size_t len;
    size_t cap;
} Coset;

typedef struct {
    Coset *data;
    size_t len;
    size_t cap;
} CosetList;

// --------- Utilidades ---------
static size_t gcd_size(size_t a, size_t b) {
    while (b != 0) {
        size_t t = a % b;
        a = b;
        b = t;
    }
    return a;
}

static void coset_init(Coset *c) {
    c->data = NULL;
    c->len = 0;
    c->cap = 0;
}

static void coset_push(Coset *c, size_t x) {
    if (c->len == c->cap) {
        size_t new_cap = c->cap ? c->cap * 2 : 8;
        size_t *new_data = (size_t*)realloc(c->data, new_cap * sizeof(size_t));
        if (!new_data) {
            fprintf(stderr, \"Error: sin memoria al ampliar coset.\\n\");
            exit(EXIT_FAILURE);
        }
        c->data = new_data;
        c->cap = new_cap;
    }
    c->data[c->len++] = x;
}

static void cosetlist_init(CosetList *cl) {
    cl->data = NULL;
    cl->len = 0;
    cl->cap = 0;
}

static void cosetlist_push(CosetList *cl, Coset c) {
    if (cl->len == cl->cap) {
        size_t new_cap = cl->cap ? cl->cap * 2 : 8;
        Coset *new_data = (Coset*)realloc(cl->data, new_cap * sizeof(Coset));
        if (!new_data) {
            fprintf(stderr, \"Error: sin memoria al ampliar lista de cosets.\\n\");
            exit(EXIT_FAILURE);
        }
        cl->data = new_data;
        cl->cap = new_cap;
    }
    cl->data[cl->len++] = c;
}

static void free_cosetlist(CosetList *cl) {
    if (!cl) return;
    for (size_t i = 0; i < cl->len; ++i) {
        free(cl->data[i].data);
        cl->data[i].data = NULL;
        cl->data[i].len = cl->data[i].cap = 0;
    }
    free(cl->data);
    cl->data = NULL;
    cl->len = cl->cap = 0;
}

// --------- Cálculo de cyclotomic cosets ---------
/**
 * Calcula las órbitas (cosets) bajo x -> (k*x) mod N para todos los residuos 0..N-1.
 * - Si gcd(k,N) == 1, cada coset es un ciclo que retorna al inicio.
 * - Si gcd(k,N) != 1, pueden aparecer cadenas que desembocan en ciclos; el algoritmo
 *   devuelve la órbita hacia delante (hasta repetir algún elemento).
 *
 * @param k  multiplicador
 * @param N  módulo
 * @return   lista de cosets (cada coset es un array de size_t)
 */
static CosetList cyclotomic_cosets(size_t k, size_t N) {
    CosetList res;
    cosetlist_init(&res);

    if (N == 0) {
        fprintf(stderr, \"Aviso: N=0 no tiene sentido; no se generan cosets.\\n\");
        return res;
    }

    size_t g = gcd_size(k % N, N);
    if (g != 1) {
        fprintf(stderr,
                \"Aviso: gcd(k,N) = %zu != 1. Las órbitas pueden ser cadenas que terminan en ciclos.\\n\",
                g);
    }

    // visited[i] indica si el residuo i ya está en algún coset.
    uint8_t *visited = (uint8_t*)calloc(N, sizeof(uint8_t));
    if (!visited) {
        fprintf(stderr, \"Error: sin memoria para 'visited'.\\n\");
        exit(EXIT_FAILURE);
    }

    for (size_t start = 0; start < N; ++start) {
        if (visited[start]) continue;

        Coset c; coset_init(&c);
        size_t x = start;

        // Generamos la órbita hasta encontrar un elemento ya visitado.
        while (!visited[x]) {
            coset_push(&c, x);
            visited[x] = 1;
            x = (x * k) % N;
        }

        // Si gcd(k,N)==1, normalmente x == start aquí (ciclo cerrado).
        // Si no, la órbita pudo entrar en un ciclo ya existente y terminamos al ver 'visited[x]'.

        cosetlist_push(&res, c);
    }

    free(visited);
    return res;
}

// --------- Impresión ---------
static void print_cosets(const CosetList *cl) {
    printf(\"Se encontraron %zu cosets:\\n\", cl->len);
    for (size_t i = 0; i < cl->len; ++i) {
        const Coset *c = &cl->data[i];
        printf(\"C%zu = { \", i);
        for (size_t j = 0; j < c->len; ++j) {
            printf(\"%zu\", c->data[j]);
            if (j + 1 < c->len) printf(\", \");
        }
        printf(\" }\\n\");
    }
}

