static void print_vector_real(const char *name, const double *v, size_t n) {
    printf(\"%s = [\", name);
    for (size_t i = 0; i < n; ++i) {
        printf(\"%.4f\", v[i]);
        if (i + 1 < n) printf(\", \");
    }
    printf(\"]\\n\");
}

static void print_vector_complex(const char *name, const double complex *v, size_t n) {
    printf(\"%s = [\", name);
    for (size_t i = 0; i < n; ++i) {
        printf(\"%.6f%+.6fi\", creal(v[i]), cimag(v[i]));
        if (i + 1 < n) printf(\", \");
    }
    printf(\"]\\n\");
}

static void print_spectrum(const char *name, const double complex *X, size_t N) {
    printf(\"%s:\\n\", name);
    for (size_t k = 0; k < N; ++k) {
        double re = creal(X[k]);
        double im = cimag(X[k]);
        double mag = hypot(re, im);
        printf(\"  k=%2zu: % .6f%+.6fi  |X|=%.6f\\n\", k, re, im, mag);
    }
}


// --------- Demo en main ---------
int main(void) {
    // Ejemplos:
    // 1) N=15, k=2 (gcd=1) -> cosets típicos (ciclos) usados en teoría de códigos
    size_t N1 = 15, k1 = 2;
    CosetList cl1 = cyclotomic_cosets(k1, N1);
    printf(\"=== Cosets para N=%zu, k=%zu ===\\n\", N1, k1);
    cosetlist_print(&cl1);
    free_cosetlist(&cl1);
    printf(\"\\n\");

    // 2) N=8, k=2 (gcd!=1) -> cadenas que desembocan en ciclo en 0
    size_t N2 = 8, k2 = 2;
    CosetList cl2 = cyclotomic_cosets(k2, N2);
    printf(\"=== Cosets para N=%zu, k=%zu ===\\n\", N2, k2);
    cosetlist_print(&cl2);
    free_cosetlist(&cl2);

    return 0;
}
